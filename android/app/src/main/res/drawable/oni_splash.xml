<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: carvão + logo + wordmark (Android 12+ usa o ícone do launcher). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/oni_bg" />
    <item
        android:gravity="center"
        android:bottom="36dp"
        android:drawable="@drawable/oni_splash_logo" />
    <item
        android:gravity="center"
        android:top="96dp"
        android:drawable="@drawable/oni_splash_wordmark" />
</layer-list>
